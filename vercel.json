{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.gingerbrosshop.com" }],
      "destination": "https://gingerbrosshop.com/$1",
      "permanent": true
    },
    {
      "source": "/product/unpasteurized",
      "destination": "/product/ginger-fizz",
      "permanent": true
    },
    {
      "source": "/wholesale",
      "destination": "/business",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/guide",
      "permanent": true
    },
    {
      "source": "/blog/art-of-the-ginger-bug",
      "destination": "/story",
      "permanent": true
    },
    {
      "source": "/blog/meet-the-brewers",
      "destination": "/story",
      "permanent": true
    },
    {
      "source": "/blog/sustainability-bottle-to-soil",
      "destination": "/story",
      "permanent": true
    },
    {
      "source": "/blog/ginger-bug-at-home",
      "destination": "/guide/thai-ginger-101",
      "permanent": true
    },
    {
      "source": "/blog/gut-health",
      "destination": "/guide/thai-ginger-101",
      "permanent": true
    },
    {
      "source": "/blog/probiotics-prebiotics",
      "destination": "/guide/thai-ginger-101",
      "permanent": true
    },
    {
      "source": "/blog/ginger-immunity",
      "destination": "/guide/thai-ginger-101",
      "permanent": true
    },
    {
      "source": "/blog/low-sugar-drinking",
      "destination": "/product/ginger-fizz",
      "permanent": true
    },
    {
      "source": "/blog/hydration-electrolytes",
      "destination": "/guide/how-to-serve-ginger-fizz",
      "permanent": true
    },
    {
      "source": "/blog/storing-living-fizz",
      "destination": "/guide/how-to-serve-ginger-fizz",
      "permanent": true
    },
    {
      "source": "/blog/unpasteurized-vs-pasteurized",
      "destination": "/guide",
      "permanent": true
    },
    {
      "source": "/blog/:slug",
      "destination": "/guide/:slug",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/x402/order",
      "destination": "/api/x402"
    },
    {
      "source": "/api",
      "destination": "/api/x402"
    },
    {
      "source": "/api/v1",
      "destination": "/api/x402"
    },
    {
      "source": "/q/:slug",
      "destination": "/api/links?qr=:slug"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/shell.html"
    }
  ],
  "crons": [
    {
      "path": "/api/abandoned-cart-check",
      "schedule": "0 14 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://www.googletagmanager.com https://connect.facebook.net https://js.stripe.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://fonts.gstatic.com https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com https://www.google.com https://stats.g.doubleclick.net https://www.facebook.com https://connect.facebook.net https://api.stripe.com; frame-src https://checkout.stripe.com https://js.stripe.com https://www.facebook.com; object-src 'none'; base-uri 'self'; form-action 'self' https://www.facebook.com; frame-ancestors 'none';"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/stickers/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/analytics.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/.well-known/api-catalog",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/linkset+json; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/.well-known/acp.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/.well-known/ucp",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/openapi.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/auth.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/docs/api.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "regions": [
    "sin1"
  ]
}
