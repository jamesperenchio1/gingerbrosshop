{
  "openapi": "3.1.0",
  "info": {
    "title": "GingerBros Shop API",
    "version": "1.0.0",
    "description": "Public storefront API for GingerBros (ginger drinks, Thailand). Read the catalog, estimate shipping, and create a hosted Stripe Checkout session. Payment is completed by the buyer on the returned Stripe-hosted page; no card details are ever sent to this API.",
    "contact": {
      "email": "gingerbros.brew@gmail.com",
      "url": "https://gingerbrosshop.com/faq"
    }
  },
  "servers": [
    {
      "url": "https://gingerbrosshop.com"
    }
  ],
  "x-service-info": {
    "categories": [
      "commerce",
      "food-and-beverage"
    ],
    "documentation": "https://gingerbrosshop.com/docs/api.md"
  },
  "paths": {
    "/api/products": {
      "get": {
        "operationId": "listProducts",
        "summary": "List the live product catalog (prices in major currency units, THB).",
        "responses": {
          "200": {
            "description": "Catalog from Stripe, cached at the edge for about 5 minutes.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "products": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "description": "App-level product id, e.g. ginger-fizz"
                          },
                          "name": {
                            "type": "string"
                          },
                          "description": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "images": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "category": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "prices": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "priceId": {
                                  "type": "string"
                                },
                                "unitAmount": {
                                  "type": [
                                    "number",
                                    "null"
                                  ]
                                },
                                "currency": {
                                  "type": "string"
                                },
                                "recurring": {
                                  "type": [
                                    "object",
                                    "null"
                                  ]
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/shipping-rate": {
      "get": {
        "operationId": "getShippingRate",
        "summary": "Estimate the delivery fee for a Thai province and cart subtotal.",
        "parameters": [
          {
            "name": "province",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Thai province name, English."
          },
          {
            "name": "subtotal",
            "in": "query",
            "schema": {
              "type": "number"
            },
            "description": "Cart subtotal in THB. Free shipping from 500."
          }
        ],
        "responses": {
          "200": {
            "description": "Shipping estimate.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "rate": {
                      "type": "number"
                    },
                    "free": {
                      "type": "boolean"
                    },
                    "estimatedDays": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/checkout": {
      "post": {
        "operationId": "createCheckoutSession",
        "summary": "Create a hosted Stripe Checkout session for a cart and return its URL.",
        "description": "Real, live-mode payment. The response is a Stripe Checkout URL that the buyer must open and pay on; this call itself does not move money. The amount depends on the cart (the figure in x-payment-info is the price of the cheapest single bottle, in satang).",
        "x-payment-info": {
          "intent": "charge",
          "method": "stripe",
          "amount": "11900",
          "currency": "THB",
          "description": "Minimum order value (one Ginger Tea bottle, THB 119.00, shipping extra). Actual amount depends on cart contents."
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "items"
                ],
                "properties": {
                  "items": {
                    "type": "array",
                    "maxItems": 50,
                    "items": {
                      "type": "object",
                      "required": [
                        "priceId",
                        "quantity"
                      ],
                      "properties": {
                        "priceId": {
                          "type": "string",
                          "description": "Stripe price id from /api/products"
                        },
                        "quantity": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 24,
                          "description": "Maximum 24 units per item; checkout caps larger quantities at 24."
                        },
                        "productId": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "promoCode": {
                    "type": "string"
                  },
                  "orderNote": {
                    "type": "string",
                    "maxLength": 500
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Checkout session created.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "url": {
                      "type": "string",
                      "format": "uri"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid cart."
          },
          "429": {
            "description": "Rate limited (10 requests per minute per IP)."
          }
        }
      }
    },
    "/api/x402/order": {
      "post": {
        "summary": "Order drinks and pay in USDC (x402, Base mainnet)",
        "description": "Real money, real delivery in Thailand. Send items (Stripe priceId + quantity, from /api/products), email, name, phone and a Thai address. Without an X-PAYMENT header the response is HTTP 402 with the exact USDC price (x402, exact scheme, network base, asset USDC, payTo 0x941eb61c0052da28d09e39f7ddc946a9631a5eeb). Sign the payment and repeat the same request with the base64 X-PAYMENT header. Orders are limited to THB 3000. The buyer must have confirmed the purchase; never place test orders.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "items",
                  "email",
                  "name",
                  "phone",
                  "address"
                ],
                "properties": {
                  "items": {
                    "type": "array",
                    "maxItems": 20,
                    "items": {
                      "type": "object",
                      "required": [
                        "priceId",
                        "quantity"
                      ],
                      "properties": {
                        "priceId": {
                          "type": "string"
                        },
                        "quantity": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 24
                        }
                      }
                    }
                  },
                  "email": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "phone": {
                    "type": "string"
                  },
                  "address": {
                    "type": "object",
                    "required": [
                      "line1",
                      "province",
                      "postalCode"
                    ],
                    "properties": {
                      "line1": {
                        "type": "string"
                      },
                      "line2": {
                        "type": "string"
                      },
                      "district": {
                        "type": "string"
                      },
                      "province": {
                        "type": "string"
                      },
                      "postalCode": {
                        "type": "string",
                        "description": "5-digit Thai postcode"
                      }
                    }
                  },
                  "coldChain": {
                    "type": "boolean"
                  },
                  "note": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Paid. Returns orderId, transaction, totalThb, paidUsdc."
          },
          "400": {
            "description": "Invalid order."
          },
          "402": {
            "description": "Payment required; x402 PaymentRequired body and PAYMENT-REQUIRED header."
          }
        }
      }
    }
  }
}
