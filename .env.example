# Stripe — the product catalog lives in Stripe and is read live via /api/products,
# so there are no per-product/price env vars. Add products & prices in Stripe and
# they appear on the site automatically.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Email (Resend — free tier: 100 emails/day)
RESEND_API_KEY=re_...
RESEND_AUDIENCE_ID=            # Optional: Resend audience ID for newsletter subscribers
SELLER_EMAIL=you@example.com
FROM_EMAIL=orders@gingerbros.co

# Admin
ADMIN_SECRET=your-random-secret-here

# Cron (for abandoned-cart-check)
CRON_SECRET=your-cron-secret-here

# Redis / Upstash (auto-added by Vercel when connecting Upstash Redis)
KV_URL=redis://...
KV_REST_API_URL=https://...
KV_REST_API_TOKEN=...
UPSTASH_REDIS_REST_URL=https://...
UPSTASH_REDIS_REST_TOKEN=...

# Meta Conversions API (server-side Purchase/Subscribe events, dataset 927558480333349)
# Generate in Events Manager -> Settings -> Conversions API -> Generate access token
META_CAPI_ACCESS_TOKEN=

# PostHog analytics (see POSTHOG.md). Both keys are the same project API key
# (`phc_...`): VITE_ is inlined into the client bundle, POSTHOG_API_KEY is used
# by the serverless functions. The browser talks to /ingest (proxied by
# vercel.json) so ad blockers and the CSP don't interfere.
VITE_POSTHOG_KEY=phc_...
VITE_POSTHOG_HOST=/ingest
POSTHOG_API_KEY=phc_...
POSTHOG_HOST=https://us.i.posthog.com
